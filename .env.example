# Tailscale IPv4 of this host (from `tailscale ip -4`). Used by Compose to bind :8321.
TAILSCALE_IP=100.x.y.z

# Fernet key for data/secrets.enc (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TGTG_BUDDY_MASTER_KEY=

# Optional override; default is ./data relative to the process cwd
DATA_DIR=./data
